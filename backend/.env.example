# LLM配置
LLM_API_KEY=your_api_key_here
LLM_API_BASE=https://api.openai.com/v1
PRIMARY_MODEL=gpt-4o
SECONDARY_MODEL=gpt-3.5-turbo
VL_MODEL=gpt-4o

# 应用配置
DEBUG=false
LOG_LEVEL=INFO

# LLM提供商配置（可选：zhipu, baidu, xunfei, openai）
LLM_PROVIDER=zhipu

# 智谱AI配置
ZHIPU_API_KEY=your_zhipu_key_here
ZHIPU_MODEL=glm-4

# 百度文心一言配置
BAIDU_API_KEY=your_baidu_key_here
BAIDU_SECRET_KEY=your_baidu_secret_here
BAIDU_MODEL=ernie-bot-4

# 讯飞星火配置
XUNFEI_APP_ID=your_xunfei_app_id_here
XUNFEI_API_KEY=your_xunfei_key_here
XUNFEI_API_SECRET=your_xunfei_secret_here
XUNFEI_MODEL=general

# 数据库配置
PB_API_BASE=http://127.0.0.1:8090
PB_API_AUTH=admin@example.com|password123

# 缓存配置
CACHE_DIR=./cache

# 应用配置
PROJECT_DIR=work_dir 